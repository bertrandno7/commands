{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/schema/command-package-v1.schema.json",
  "title": "COMMANDS package manifest",
  "description": "Manifest for one immutable, downloadable Rhino command package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "slug",
    "name",
    "commandName",
    "version",
    "summary",
    "description",
    "category",
    "license",
    "entrypoint",
    "icon",
    "runtime",
    "dependencies",
    "permissions",
    "interface"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "slug": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 2, "maxLength": 80 },
    "commandName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "summary": { "type": "string", "minLength": 10, "maxLength": 240 },
    "description": { "type": "string", "minLength": 10, "maxLength": 4000 },
    "category": {
      "enum": ["Geometry", "Analysis", "AI", "Facade", "Massing", "Utilities"]
    },
    "tags": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 },
      "default": []
    },
    "license": {
      "description": "An SPDX expression where known; imported drafts may use LicenseRef-Pending.",
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 100
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": { "$ref": "#/$defs/packagePath" },
        "callable": { "type": "string", "minLength": 1, "maxLength": 80, "default": "run" }
      }
    },
    "icon": { "$ref": "#/$defs/packagePath" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "rhinoVersions", "pythonEngine"],
      "properties": {
        "host": { "const": "rhino" },
        "rhinoVersions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "pythonEngine": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "commands", "rhinoPlugins", "files"],
      "properties": {
        "python": { "$ref": "#/$defs/dependencyNames" },
        "rhinoPlugins": { "$ref": "#/$defs/dependencyNames" },
        "files": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/packagePath" },
          "default": []
        },
        "commands": {
          "type": "array",
          "maxItems": 50,
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 160 },
              "version": { "type": "string", "minLength": 1, "maxLength": 80, "default": "*" }
            }
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/permission" },
      "default": []
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "outputs"],
      "properties": {
        "inputs": { "$ref": "#/$defs/ports" },
        "outputs": { "$ref": "#/$defs/ports" },
        "objectives": { "$ref": "#/$defs/ports" },
        "metrics": { "$ref": "#/$defs/ports" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "callable": { "type": "boolean", "default": false },
        "description": { "type": "string", "maxLength": 1000 },
        "inputSchema": { "type": "object" },
        "outputSchema": { "type": "object" },
        "sideEffects": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/permission" },
          "default": []
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source"],
      "properties": {
        "status": { "enum": ["community-publish", "imported-draft"] },
        "source": { "type": "string", "minLength": 1, "maxLength": 500 },
        "sourceFile": { "type": "string", "maxLength": 240 },
        "snapshotDate": { "type": "string", "format": "date" }
      }
    }
  },
  "$defs": {
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "permission": {
      "enum": [
        "document.read",
        "document.write",
        "filesystem.read",
        "filesystem.write",
        "network",
        "clipboard",
        "subprocess"
      ]
    },
    "dependencyNames": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 },
      "default": []
    },
    "ports": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/port" },
      "default": []
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "type": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "required": { "type": "boolean", "default": false },
        "default": {}
      }
    }
  }
}
